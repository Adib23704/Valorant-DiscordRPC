{
  "name": "valorant-discordrpc",
  "description": "A modern Discord Rich Presence client for Valorant that displays your in-game status on Discord.",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Adib23704",
    "email": "adib23704@gmail.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "lint:rust": "cd src-tauri && cargo clippy -- -D warnings",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "format:rust": "cd src-tauri && cargo fmt",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "check:rust": "cd src-tauri && cargo fmt --check",
    "validate": "biome check . && cd src-tauri && cargo fmt --check && cargo clippy -- -D warnings",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched",
    "src-tauri/**/*.rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --"
  }
}
